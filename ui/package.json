{
  "name": "rancher-secrets-manager-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Rancher UI Extension for managing ManagedSecret CRDs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "clean": "node node_modules/@rancher/shell/scripts/clean",
    "build-pkg": "bash node_modules/@rancher/shell/scripts/build-pkg.sh rancher-secrets-manager",
    "serve-pkgs": "bash node_modules/@rancher/shell/scripts/serve-pkgs",
    "publish-pkgs": "bash node_modules/@rancher/shell/scripts/extension/publish",
    "lint": "eslint --ext .js,.ts,.vue pkg"
  },
  "dependencies": {
    "@rancher/shell": "^3.0.0"
  },
  "resolutions": {
    "@types/node": "20.10.8",
    "@types/lodash": "4.17.5"
  }
}
